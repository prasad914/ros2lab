<?xml version="1.0"?>
<!-- TEST FIXTURE (stand-in for the course robot chiku, not the real file) -->
<robot name="chiku" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_r" value="0.035"/>
  <link name="base_footprint"/>
  <link name="base_link"><visual><geometry><box size="0.2 0.16 0.06"/></geometry><material name="m_base_link"><color rgba="0.2 0.2 0.2 1"/></material></visual><collision><geometry><box size="0.2 0.16 0.06"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.045"/></joint>
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel"><visual><geometry><cylinder radius="${wheel_r}" length="0.03"/></geometry><material name="m_${side}_wheel"><color rgba="0.2 0.2 0.2 1"/></material></visual><collision><geometry><cylinder radius="${wheel_r}" length="0.03"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel"/><origin xyz="0 ${y} -0.01" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/></joint>
  </xacro:macro>
  <xacro:wheel side="left" y="0.095"/>
  <xacro:wheel side="right" y="-0.095"/>
  <link name="caster"><visual><geometry><sphere radius="0.015"/></geometry><material name="m_caster"><color rgba="0.2 0.2 0.2 1"/></material></visual><collision><geometry><sphere radius="0.015"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster"/><origin xyz="-0.08 0 -0.03"/></joint>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.03" length="0.03"/></geometry><material name="m_lidar_link"><color rgba="0.2 0.2 0.2 1"/></material></visual><collision><geometry><cylinder radius="0.03" length="0.03"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.05"/></joint>
</robot>
