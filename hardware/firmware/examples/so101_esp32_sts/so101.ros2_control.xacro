<?xml version="1.0"?>
<!-- so101: ros2_control for mock / Gazebo / the real robot (ros2lab_hardware). Generated by ros2lab_robot_setup. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="hardware_type" default="mock"/>
  <xacro:arg name="transport" default="serial"/>
  <xacro:arg name="device" default="/dev/ros2lab_mcu"/>
  <xacro:arg name="host" default="192.168.4.1"/>
  <xacro:include filename="$(find ros2lab_hardware)/config/bridge.ros2_control.xacro"/>
  <xacro:ros2lab_system name="so101" hardware_type="$(arg hardware_type)" transport="$(arg transport)" device="$(arg device)" baud="921600" host="$(arg host)" robot_id="so101">
    <interfaces>
      <joint name="gripper">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.000</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wrist_roll">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.000</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wrist_flex">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.000</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="elbow_flex">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.000</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="shoulder_lift">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.000</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="shoulder_pan">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.000</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </interfaces>
  </xacro:ros2lab_system>
</robot>
