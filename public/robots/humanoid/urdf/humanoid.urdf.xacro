<?xml version="1.0"?>
<!-- A simple humanoid: 21 revolute joints (waist, neck pan/tilt, 3 per arm, 6 per leg), using arm and leg macros -->
<robot name="humanoid" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="../../common/urdf/macros.xacro"/>
  <xacro:macro name="rev" params="name parent child xyz axis lo hi rpy:='0 0 0'">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/><child link="${child}"/><origin xyz="${xyz}" rpy="${rpy}"/><axis xyz="${axis}"/>
      <limit lower="${lo}" upper="${hi}" effort="30" velocity="3"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="blob" params="name m">
    <link name="${name}">
      <visual><geometry><sphere radius="0.035"/></geometry><material name="dark_grey"/></visual>
      <collision><geometry><sphere radius="0.035"/></geometry></collision>
      <xacro:sphere_inertia m="${m}" r="0.035"/>
    </link>
  </xacro:macro>
  <link name="pelvis">
    <visual><geometry><box size="0.20 0.25 0.10"/></geometry><material name="dark_grey"/></visual>
    <collision><geometry><box size="0.20 0.25 0.10"/></geometry></collision>
    <xacro:box_inertia m="5.0" x="0.20" y="0.25" z="0.10"/>
  </link>
  <xacro:rev name="waist_joint" parent="pelvis" child="torso" xyz="0 0 0.05" axis="0 0 1" lo="-1.0" hi="1.0"/>
  <link name="torso">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.18 0.28 0.30"/></geometry><material name="white"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.18 0.28 0.30"/></geometry></collision>
    <xacro:box_inertia m="8.0" x="0.18" y="0.28" z="0.30" xyz="0 0 0.15"/>
  </link>
  <xacro:rev name="neck_pan_joint" parent="torso" child="neck" xyz="0 0 0.30" axis="0 0 1" lo="-1.2" hi="1.2"/>
  <xacro:blob name="neck" m="0.2"/>
  <xacro:rev name="head_tilt_joint" parent="neck" child="head" xyz="0 0 0.04" axis="0 1 0" lo="-0.5" hi="0.6"/>
  <link name="head">
    <visual><origin xyz="0 0 0.09"/><geometry><sphere radius="0.09"/></geometry><material name="white"/></visual>
    <visual><origin xyz="0.08 0 0.10"/><geometry><box size="0.02 0.12 0.03"/></geometry><material name="sky_blue"/></visual>
    <collision><origin xyz="0 0 0.09"/><geometry><sphere radius="0.09"/></geometry></collision>
    <xacro:sphere_inertia m="1.5" r="0.09" xyz="0 0 0.09"/>
  </link>
  <xacro:macro name="arm" params="side s roll_lo roll_hi">
    <xacro:rev name="${side}_shoulder_pitch_joint" parent="torso" child="${side}_shoulder" xyz="0 ${s*0.17} 0.27" axis="0 1 0" lo="-3.0" hi="3.0"/>
    <xacro:blob name="${side}_shoulder" m="0.3"/>
    <xacro:rev name="${side}_shoulder_roll_joint" parent="${side}_shoulder" child="${side}_upper_arm" xyz="0 0 0" axis="1 0 0" lo="${roll_lo}" hi="${roll_hi}"/>
    <link name="${side}_upper_arm">
      <visual><origin xyz="0 0 -0.125"/><geometry><box size="0.05 0.05 0.25"/></geometry><material name="orange"/></visual>
      <collision><origin xyz="0 0 -0.125"/><geometry><box size="0.05 0.05 0.25"/></geometry></collision>
      <xacro:box_inertia m="1.0" x="0.05" y="0.05" z="0.25" xyz="0 0 -0.125"/>
    </link>
    <xacro:rev name="${side}_elbow_joint" parent="${side}_upper_arm" child="${side}_forearm" xyz="0 0 -0.25" axis="0 1 0" lo="-2.3" hi="0"/>
    <link name="${side}_forearm">
      <visual><origin xyz="0 0 -0.11"/><geometry><box size="0.045 0.045 0.22"/></geometry><material name="orange"/></visual>
      <visual><origin xyz="0 0 -0.24"/><geometry><sphere radius="0.035"/></geometry><material name="dark_grey"/></visual>
      <collision><origin xyz="0 0 -0.11"/><geometry><box size="0.045 0.045 0.22"/></geometry></collision>
      <collision><origin xyz="0 0 -0.24"/><geometry><sphere radius="0.035"/></geometry></collision>
      <xacro:box_inertia m="0.7" x="0.045" y="0.045" z="0.22" xyz="0 0 -0.11"/>
    </link>
  </xacro:macro>
  <xacro:arm side="left" s="1" roll_lo="-1.5" roll_hi="0.2"/>
  <xacro:arm side="right" s="-1" roll_lo="-0.2" roll_hi="1.5"/>
  <xacro:macro name="leg" params="side s">
    <xacro:rev name="${side}_hip_yaw_joint" parent="pelvis" child="${side}_hip1" xyz="0 ${s*0.08} -0.05" axis="0 0 1" lo="-0.6" hi="0.6"/>
    <xacro:blob name="${side}_hip1" m="0.3"/>
    <xacro:rev name="${side}_hip_roll_joint" parent="${side}_hip1" child="${side}_hip2" xyz="0 0 0" axis="1 0 0" lo="-0.5" hi="0.5"/>
    <xacro:blob name="${side}_hip2" m="0.3"/>
    <xacro:rev name="${side}_hip_pitch_joint" parent="${side}_hip2" child="${side}_thigh" xyz="0 0 0" axis="0 1 0" lo="-1.8" hi="0.8"/>
    <link name="${side}_thigh">
      <visual><origin xyz="0 0 -0.16"/><geometry><box size="0.07 0.07 0.32"/></geometry><material name="white"/></visual>
      <collision><origin xyz="0 0 -0.16"/><geometry><box size="0.07 0.07 0.32"/></geometry></collision>
      <xacro:box_inertia m="2.5" x="0.07" y="0.07" z="0.32" xyz="0 0 -0.16"/>
    </link>
    <xacro:rev name="${side}_knee_joint" parent="${side}_thigh" child="${side}_shin" xyz="0 0 -0.32" axis="0 1 0" lo="0" hi="2.2"/>
    <link name="${side}_shin">
      <visual><origin xyz="0 0 -0.16"/><geometry><box size="0.06 0.06 0.32"/></geometry><material name="white"/></visual>
      <collision><origin xyz="0 0 -0.16"/><geometry><box size="0.06 0.06 0.32"/></geometry></collision>
      <xacro:box_inertia m="1.8" x="0.06" y="0.06" z="0.32" xyz="0 0 -0.16"/>
    </link>
    <xacro:rev name="${side}_ankle_pitch_joint" parent="${side}_shin" child="${side}_ankle" xyz="0 0 -0.32" axis="0 1 0" lo="-0.8" hi="0.8"/>
    <xacro:blob name="${side}_ankle" m="0.2"/>
    <xacro:rev name="${side}_ankle_roll_joint" parent="${side}_ankle" child="${side}_foot" xyz="0 0 0" axis="1 0 0" lo="-0.4" hi="0.4"/>
    <link name="${side}_foot">
      <visual><origin xyz="0.03 0 -0.04"/><geometry><box size="0.18 0.08 0.03"/></geometry><material name="dark_grey"/></visual>
      <collision><origin xyz="0.03 0 -0.04"/><geometry><box size="0.18 0.08 0.03"/></geometry></collision>
      <xacro:box_inertia m="0.5" x="0.18" y="0.08" z="0.03" xyz="0.03 0 -0.04"/>
    </link>
  </xacro:macro>
  <xacro:leg side="left" s="1"/>
  <xacro:leg side="right" s="-1"/>
</robot>
