<?xml version="1.0"?>
<!-- A 3-DOF robotic arm with a 2-finger gripper on a fixed stand -->
<robot name="arm3_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="../../common/urdf/macros.xacro"/>
  <xacro:include filename="../../common/urdf/arm3_macro.xacro"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.01"/><geometry><box size="0.30 0.30 0.02"/></geometry><material name="light_grey"/></visual>
    <collision><origin xyz="0 0 0.01"/><geometry><box size="0.30 0.30 0.02"/></geometry></collision>
    <xacro:box_inertia m="3.0" x="0.30" y="0.30" z="0.02" xyz="0 0 0.01"/>
  </link>
  <xacro:arm3 prefix="" parent="base_link" xyz="0 0 0.02"/>
</robot>
