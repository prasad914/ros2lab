<?xml version="1.0"?>
<!-- An omnidirectional robot with 4 mecanum wheels. The tilted bars show the 45-degree rollers. -->
<robot name="mecanum" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="../../common/urdf/macros.xacro"/>
  <xacro:property name="wr" value="0.06"/>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wr}"/></joint>
  <link name="base_link">
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.40 0.28 0.08"/></geometry><material name="sky_blue"/></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><box size="0.40 0.28 0.08"/></geometry></collision>
    <xacro:box_inertia m="4.0" x="0.40" y="0.28" z="0.08" xyz="0 0 0.04"/>
  </link>
  <xacro:macro name="mwheel" params="name x y roller">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/><origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
    <link name="${name}_wheel">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wr}" length="0.05"/></geometry><material name="dark_grey"/></visual>
      <visual><origin rpy="${roller} 0 0"/><geometry><box size="0.012 0.06 ${2*wr+0.005}"/></geometry><material name="light_grey"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wr}" length="0.05"/></geometry></collision>
      <xacro:cylinder_inertia m="0.3" r="${wr}" h="0.05" rpy="${pi/2} 0 0"/>
    </link>
  </xacro:macro>
  <xacro:mwheel name="front_left" x="0.15" y="0.17" roller="${pi/4}"/>
  <xacro:mwheel name="front_right" x="0.15" y="-0.17" roller="${-pi/4}"/>
  <xacro:mwheel name="rear_left" x="-0.15" y="0.17" roller="${-pi/4}"/>
  <xacro:mwheel name="rear_right" x="-0.15" y="-0.17" roller="${pi/4}"/>
</robot>
