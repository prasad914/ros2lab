<?xml version="1.0"?>
<!-- A car-like (Ackermann) robot: two steering joints (revolute) + four wheels (continuous) -->
<robot name="ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="../../common/urdf/macros.xacro"/>
  <xacro:property name="wr" value="0.07"/>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wr}"/></joint>
  <link name="base_link">
    <visual><origin xyz="0 0 0.06"/><geometry><box size="0.60 0.30 0.12"/></geometry><material name="red"/></visual>
    <visual><origin xyz="-0.05 0 0.15"/><geometry><box size="0.30 0.26 0.08"/></geometry><material name="dark_grey"/></visual>
    <collision><origin xyz="0 0 0.06"/><geometry><box size="0.60 0.30 0.12"/></geometry></collision>
    <xacro:box_inertia m="5.0" x="0.60" y="0.30" z="0.12" xyz="0 0 0.06"/>
  </link>
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wr}" length="0.05"/></geometry><material name="dark_grey"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wr}" length="0.05"/></geometry></collision>
      <xacro:cylinder_inertia m="0.3" r="${wr}" h="0.05" rpy="${pi/2} 0 0"/>
    </link>
  </xacro:macro>
  <xacro:macro name="rear_wheel" params="side s">
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="rear_${side}_wheel"/><origin xyz="-0.20 ${s*0.18} 0"/><axis xyz="0 1 0"/>
    </joint>
    <xacro:wheel_link name="rear_${side}_wheel"/>
  </xacro:macro>
  <xacro:macro name="front_wheel" params="side s">
    <joint name="front_${side}_steer_joint" type="revolute">
      <parent link="base_link"/><child link="front_${side}_steer"/><origin xyz="0.20 ${s*0.18} 0"/><axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="5" velocity="2"/>
    </joint>
    <link name="front_${side}_steer">
      <visual><geometry><cylinder radius="0.015" length="0.04"/></geometry><material name="light_grey"/></visual>
      <collision><geometry><cylinder radius="0.015" length="0.04"/></geometry></collision>
      <xacro:cylinder_inertia m="0.05" r="0.015" h="0.04"/>
    </link>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_steer"/><child link="front_${side}_wheel"/><axis xyz="0 1 0"/>
    </joint>
    <xacro:wheel_link name="front_${side}_wheel"/>
  </xacro:macro>
  <xacro:rear_wheel side="left" s="1"/>
  <xacro:rear_wheel side="right" s="-1"/>
  <xacro:front_wheel side="left" s="1"/>
  <xacro:front_wheel side="right" s="-1"/>
</robot>
