 "gallery": {
  "gen3": {
   "package": "kortex_description",
   "file": "robots/kinova.urdf.xacro",
   "args": [
    "robot_ip:=xxx.yyy.zzz.www",
    "name:=gen3",
    "arm:=gen3",
    "dof:=7",
    "vision:=false",
    "prefix:=",
    "sim_gazebo:=false",
    "gripper:="
   ],
   "cmd": "xacro $(ros2 pkg prefix kortex_description)/share/kortex_description/robots/kinova.urdf.xacro robot_ip:=xxx.yyy.zzz.www name:=gen3 arm:=gen3 dof:=7 vision:=false prefix:= sim_gazebo:=false gripper:=",
   "src": "src/ros2_kortex/kortex_description/robots/kinova.urdf.xacro",
   "urdf": "generated/gen3.urdf"
  }
 },
 "entry": {
  "sim": [
   {
    "title": "Gazebo + ros2_control (Gen3 7-DoF)",
    "cmd": "ros2 launch kortex_bringup kortex_sim_control.launch.py use_sim_time:=true launch_rviz:=false"
   }
  ],
  "moveit": [
   {
    "title": "MoveIt 2 for the Gazebo arm (start \"Gazebo + ros2_control\" first)",
    "cmd": "ros2 launch kinova_gen3_7dof_robotiq_2f_85_moveit_config sim.launch.py use_sim_time:=true"
   },
   {
    "title": "MoveIt 2 with fake hardware",
    "cmd": "ros2 launch kinova_gen3_7dof_robotiq_2f_85_moveit_config robot.launch.py robot_ip:=yyy.yyy.yyy.yyy use_fake_hardware:=true"
   }
  ],
  "rviz": {
   "title": "Robot model in RViz",
   "cmd": "ros2 launch kortex_description view_robot.launch.py"
  },
  "fake": {
   "title": "ros2_control with fake hardware",
   "cmd": "ros2 launch kortex_bringup gen3.launch.py robot_ip:=yyy.yyy.yyy.yyy use_fake_hardware:=true"
  },
  "real": {
   "title": "Real Gen3 (kortex_driver)",
   "cmd": "ros2 launch kortex_bringup gen3.launch.py robot_ip:=192.168.1.10",
   "then": "ros2 launch kinova_gen3_7dof_robotiq_2f_85_moveit_config robot.launch.py robot_ip:=192.168.1.10",
   "needs": "a Kinova Gen3 arm on the network (the Kortex API is downloaded by kortex_api at build time)",
   "notes": "Default IP of the arm is 192.168.1.10."
  }
 },
 "known_issues": [
  "kortex_description/robots/gen3_robotiq_2f_85.xacro (not used by any launch file) fails in xacro on the jazzy branch: 'Invalid parameter sim' for macro load_robot."
 ],
 "ubuntu": {
  "repos_file": "kortex.repos",
  "steps": [
   "sudo apt install python3-vcstool python3-colcon-common-extensions python3-rosdep",
   "mkdir -p ~/ros2_ws/src && cd ~/ros2_ws",
   "vcs import --recursive src < kortex.repos",
   "source /opt/ros/jazzy/setup.bash",
   "sudo rosdep init 2>/dev/null; rosdep update",
   "rosdep install --from-paths src --ignore-src -r -y --rosdistro jazzy",
   "colcon build --symlink-install",
   "source install/setup.bash"
  ]
 },
 "honesty": "The site runs these real launch files, YAML, URDF/xacro and SDF files in the browser and models the programs they start (gz sim, controller_manager, move_group, Nav2 servers ...) in JavaScript. It cannot run the compiled C++ nodes. On a real Ubuntu 24.04 + ROS 2 Jazzy machine the same workspace builds and runs with the steps below.",
 "pruned": "Only the mesh/texture files used by the robots and worlds listed in 'gallery' and the entries are shipped (vcs import gets the complete repositories).",
