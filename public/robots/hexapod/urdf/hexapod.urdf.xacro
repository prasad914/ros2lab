<?xml version="1.0"?>
<!-- A 6-legged spider robot: 18 revolute joints (coxa, femur, tibia per leg). Each leg's joint origin is turned by its yaw angle. -->
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="../../common/urdf/macros.xacro"/>
  <xacro:property name="body_r" value="0.15"/>
  <link name="base_link">
    <visual><geometry><cylinder radius="${body_r}" length="0.06"/></geometry><material name="dark_grey"/></visual>
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.07" length="0.03"/></geometry><material name="green"/></visual>
    <collision><geometry><cylinder radius="${body_r}" length="0.06"/></geometry></collision>
    <xacro:cylinder_inertia m="2.0" r="${body_r}" h="0.06"/>
  </link>
  <xacro:macro name="hex_leg" params="n yaw_deg">
    <xacro:property name="yaw" value="${radians(yaw_deg)}"/>
    <joint name="leg${n}_coxa_joint" type="revolute">
      <parent link="base_link"/><child link="leg${n}_coxa_link"/>
      <origin xyz="${body_r*cos(yaw)} ${body_r*sin(yaw)} 0" rpy="0 0 ${yaw}"/><axis xyz="0 0 1"/>
      <limit lower="-0.8" upper="0.8" effort="5" velocity="5"/>
    </joint>
    <link name="leg${n}_coxa_link">
      <visual><origin xyz="0.025 0 0"/><geometry><box size="0.05 0.03 0.03"/></geometry><material name="light_grey"/></visual>
      <collision><origin xyz="0.025 0 0"/><geometry><box size="0.05 0.03 0.03"/></geometry></collision>
      <xacro:box_inertia m="0.05" x="0.05" y="0.03" z="0.03" xyz="0.025 0 0"/>
    </link>
    <joint name="leg${n}_femur_joint" type="revolute">
      <parent link="leg${n}_coxa_link"/><child link="leg${n}_femur_link"/>
      <origin xyz="0.05 0 0"/><axis xyz="0 1 0"/><limit lower="-1.2" upper="1.2" effort="5" velocity="5"/>
    </joint>
    <link name="leg${n}_femur_link">
      <visual><origin xyz="0.05 0 0"/><geometry><box size="0.10 0.025 0.025"/></geometry><material name="green"/></visual>
      <collision><origin xyz="0.05 0 0"/><geometry><box size="0.10 0.025 0.025"/></geometry></collision>
      <xacro:box_inertia m="0.08" x="0.10" y="0.025" z="0.025" xyz="0.05 0 0"/>
    </link>
    <joint name="leg${n}_tibia_joint" type="revolute">
      <parent link="leg${n}_femur_link"/><child link="leg${n}_tibia_link"/>
      <origin xyz="0.10 0 0" rpy="0 1.0 0"/><axis xyz="0 1 0"/><limit lower="-1.0" upper="1.0" effort="5" velocity="5"/>
    </joint>
    <link name="leg${n}_tibia_link">
      <visual><origin xyz="0.07 0 0"/><geometry><box size="0.14 0.02 0.02"/></geometry><material name="light_grey"/></visual>
      <collision><origin xyz="0.07 0 0"/><geometry><box size="0.14 0.02 0.02"/></geometry></collision>
      <xacro:box_inertia m="0.06" x="0.14" y="0.02" z="0.02" xyz="0.07 0 0"/>
    </link>
    <joint name="leg${n}_foot_joint" type="fixed">
      <parent link="leg${n}_tibia_link"/><child link="leg${n}_foot_link"/><origin xyz="0.14 0 0"/>
    </joint>
    <link name="leg${n}_foot_link">
      <visual><geometry><sphere radius="0.012"/></geometry><material name="dark_grey"/></visual>
      <collision><geometry><sphere radius="0.012"/></geometry></collision>
    </link>
  </xacro:macro>
  <xacro:hex_leg n="1" yaw_deg="0"/>
  <xacro:hex_leg n="2" yaw_deg="60"/>
  <xacro:hex_leg n="3" yaw_deg="120"/>
  <xacro:hex_leg n="4" yaw_deg="180"/>
  <xacro:hex_leg n="5" yaw_deg="240"/>
  <xacro:hex_leg n="6" yaw_deg="300"/>
</robot>
