<?xml version="1.0"?>
<!-- ROS2Lab physics baseline world "incline_30" (parity/scripts/physics/gen_worlds.py) -->
<sdf version="1.10">
  <world name="incline_30">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <model name="ramp">
      <static>true</static>
      <pose>0 0 3.5 0 0.523598776 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 4 0.1</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>6 4 0.1</size></box></geometry></visual>
      </link>
    </model>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </visual>
      </link>
    </model>
    <model name="sphere">
      <pose>-2.090063509 -0.5 4.879903811 0 0 0</pose>
      <link name="link">
        <inertial><mass>1.0</mass><inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.1</radius></sphere></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>-1</update_frequency>
      </plugin>
    </model>
    <model name="cylinder">
      <pose>-2.090063509 0.5 4.879903811 1.570796327 0 0</pose>
      <link name="link">
        <inertial><mass>1.0</mass><inertia><ixx>0.00583333</ixx><iyy>0.00583333</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.2</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.2</length></cylinder></geometry></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>-1</update_frequency>
      </plugin>
    </model>
    <model name="box_frictionless">
      <pose>-2.090063509 1.5 4.879903811 0 0.523598776 0</pose>
      <link name="link">
        <inertial><mass>1.0</mass><inertia><ixx>0.00666667</ixx><iyy>0.00666667</iyy><izz>0.00666667</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.2 0.2 0.2</size></box></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
        
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>-1</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
