diff --git a/interbotix_ros_xsarms/interbotix_xsarm_sim/launch/xsarm_gz_harmonic.launch.py b/interbotix_ros_xsarms/interbotix_xsarm_sim/launch/xsarm_gz_harmonic.launch.py
