From: Prasad Prabhu <prasadprabhu@nitte.edu.in>
Date: Sun, 18 Oct 2026 12:51:02 +0530
Subject: [PATCH 3/6] xsarm_moveit kinematics.yaml: KDL (lma_kinematics_plugin
 is not in Jazzy moveit_kinematics)

---
 .../interbotix_xsarm_moveit/config/kinematics.yaml              | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/interbotix_ros_xsarms/interbotix_xsarm_moveit/config/kinematics.yaml b/interbotix_ros_xsarms/interbotix_xsarm_moveit/config/kinematics.yaml
index 96823f2..922bb81 100644
--- a/interbotix_ros_xsarms/interbotix_xsarm_moveit/config/kinematics.yaml
+++ b/interbotix_ros_xsarms/interbotix_xsarm_moveit/config/kinematics.yaml
@@ -2,7 +2,7 @@
   ros__parameters:
     robot_description_kinematics:
       interbotix_arm:
-        kinematics_solver: lma_kinematics_plugin/LMAKinematicsPlugin
+        kinematics_solver: kdl_kinematics_plugin/KDLKinematicsPlugin
         kinematics_solver_search_resolution: 0.005
         kinematics_solver_timeout: 0.005
         position_only_ik: false
