Subject: [PATCH 3/3] xs_launch.py: hardware_type gz_harmonic (Gazebo Harmonic,
 ROS2Lab port) accepted and uses sim time

---
 .../interbotix_moveit_interface/COLCON_IGNORE                 | 0
 .../interbotix_moveit_interface_msgs/COLCON_IGNORE            | 0
 .../interbotix_xs_modules/xs_launch/xs_launch.py              | 4 +++-
 3 files changed, 3 insertions(+), 1 deletion(-)
 delete mode 100644 interbotix_common_toolbox/interbotix_moveit_interface/COLCON_IGNORE
 delete mode 100644 interbotix_common_toolbox/interbotix_moveit_interface_msgs/COLCON_IGNORE

diff --git a/interbotix_common_toolbox/interbotix_moveit_interface/COLCON_IGNORE b/interbotix_common_toolbox/interbotix_moveit_interface/COLCON_IGNORE
deleted file mode 100644
index e69de29..0000000
diff --git a/interbotix_common_toolbox/interbotix_moveit_interface_msgs/COLCON_IGNORE b/interbotix_common_toolbox/interbotix_moveit_interface_msgs/COLCON_IGNORE
deleted file mode 100644
index e69de29..0000000
diff --git a/interbotix_xs_toolbox/interbotix_xs_modules/interbotix_xs_modules/xs_launch/xs_launch.py b/interbotix_xs_toolbox/interbotix_xs_modules/interbotix_xs_modules/xs_launch/xs_launch.py
index 1719cfd..12da491 100644
--- a/interbotix_xs_toolbox/interbotix_xs_modules/interbotix_xs_modules/xs_launch/xs_launch.py
+++ b/interbotix_xs_toolbox/interbotix_xs_modules/interbotix_xs_modules/xs_launch/xs_launch.py
@@ -366,6 +366,7 @@ def declare_interbotix_xsarm_robot_description_launch_arguments(
                 'actual',
                 'fake',
                 'gz_classic',
+                'gz_harmonic',
             ),
             default_value=hardware_type,
             description=(
@@ -464,6 +465,7 @@ def declare_interbotix_xslocobot_robot_description_launch_arguments(
                 'actual',
                 'fake',
                 'gz_classic',
+                'gz_harmonic',
             ),
             default_value=hardware_type,
             description=(
@@ -556,7 +558,7 @@ def determine_use_sim_time_param(
     :param hardware_type: The `hardware_type` LaunchConfiguration
     :return: True if hardware is simulated, the `use_sim_time` LaunchConfiguration otherwise
     """
-    if hardware_type_launch_arg.perform(context) in ('gz_classic'):
+    if hardware_type_launch_arg.perform(context) in ('gz_classic', 'gz_harmonic'):
         return TextSubstitution(text='true')
     else:
         return LaunchConfiguration('use_sim_time')
